{
  "name": "shared",
  "version": "1.0.0",
  "private": true,
  "description": "Kinora app UI shared by every platform (mobile + TV modes)",
  "scripts": {
    "sync-tokens": "node scripts/sync-tokens.mjs",
    "dev": "npm run sync-tokens && vite",
    "build": "npm run sync-tokens && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "test": "node --test test/unit.test.mjs test/appshell.test.mjs",
    "e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "core-js": "3.51.0",
    "hls.js": "1.6.19",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
