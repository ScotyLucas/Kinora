<?xml version="1.0" encoding="utf-8"?>
<!-- Long press on the app icon. MainActivity opens them as kinora:// links. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="resume" android:enabled="true" android:icon="@drawable/ic_shortcut_play"
        android:shortcutShortLabel="@string/shortcut_resume" android:shortcutLongLabel="@string/shortcut_resume_long">
        <intent android:action="android.intent.action.VIEW" android:data="kinora://resume"
            android:targetPackage="io.github.scotylucas.kinora" android:targetClass="io.github.scotylucas.kinora.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="search" android:enabled="true" android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search" android:shortcutLongLabel="@string/shortcut_search">
        <intent android:action="android.intent.action.VIEW" android:data="kinora://search"
            android:targetPackage="io.github.scotylucas.kinora" android:targetClass="io.github.scotylucas.kinora.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="journal" android:enabled="true" android:icon="@drawable/ic_shortcut_journal"
        android:shortcutShortLabel="@string/widget_journal" android:shortcutLongLabel="@string/widget_journal">
        <intent android:action="android.intent.action.VIEW" android:data="kinora://journal"
            android:targetPackage="io.github.scotylucas.kinora" android:targetClass="io.github.scotylucas.kinora.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="downloads" android:enabled="true" android:icon="@drawable/ic_shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads" android:shortcutLongLabel="@string/shortcut_downloads">
        <intent android:action="android.intent.action.VIEW" android:data="kinora://downloads"
            android:targetPackage="io.github.scotylucas.kinora" android:targetClass="io.github.scotylucas.kinora.MainActivity" />
    </shortcut>
</shortcuts>
